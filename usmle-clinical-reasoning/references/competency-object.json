    {
      "layer": "SOURCE",
      "statement": "Step 2 CK assesses application of medical knowledge and clinical science for patient care under supervision.",
      "source_ids": [
        "F2-66-007"
      ]
    },
    {
      "layer": "SOURCE",
      "statement": "Core EPAs frame integrated activities that may be entrusted with appropriate supervision.",
      "source_ids": [
        "F2-66-008"
      ]
    },
    {
      "layer": "INFERENCE",
      "statement": "The textbook should require case representation, evidence, safety, escalation, and reassessment.",
